{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "description": "derprito64bit's portfolio at derprito64bit.github.io: a static Astro site with one riding WebGL canvas (Darkroom direction).",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tokens": "node scripts/build/tokens.mjs",
    "images": "node scripts/build/images.mjs",
    "fonts": "uvx --from fonttools[woff]==4.66.1 --with brotli==1.2.0 python scripts/build/fonts/build.py",
    "build": "node scripts/build/tokens.mjs && node scripts/build/images.mjs && astro build",
    "astro:check": "astro check",
    "lint": "node scripts/check/lint.mjs",
    "check": "node scripts/check/run.mjs",
    "check:ownership": "node scripts/check/ownership.mjs",
    "check:deps": "node scripts/check/deps.mjs",
    "check:ph": "node scripts/check/ph-gate.mjs",
    "check:css": "node scripts/check/css-lint.mjs",
    "check:stacking": "node scripts/check/stacking.mjs",
    "check:tokens": "node scripts/check/tokens-determinism.mjs",
    "size": "size-limit",
    "serve": "node scripts/serve-dist.mjs",
    "crew": "node scripts/crew.mjs",
    "test:w-f": "node tests/w-f/run.mjs",
    "test:w-f-unit": "node --test \"tests/w-f/**/*.test.mjs\"",
    "glb": "node scripts/build/glb/optimize.mjs && node scripts/build/glb/rig.mjs",
    "glb:check": "node scripts/build/glb/optimize.mjs --check && node scripts/build/glb/rig.mjs --check",
    "posters": "node scripts/build/posters/render.mjs",
    "test:w-c13": "node --test \"tests/w-c13/**/*.test.mjs\"",
    "h:console": "node tests/harness/console/run.mjs",
    "h:overflow": "node tests/harness/overflow/run.mjs",
    "h:drift": "node tests/harness/drift/run.mjs",
    "h:gpu": "node tests/harness/gpu/run.mjs",
    "h:idle": "node tests/harness/idle/run.mjs",
    "h:swap": "node tests/harness/swap/run.mjs",
    "h:spring": "node tests/harness/spring/run.mjs",
    "h:contrast": "node tests/harness/contrast/run.mjs",
    "h:content": "node tests/harness/content/run.mjs",
    "h:flash": "node tests/harness/flash/run.mjs",
    "h:keyboard": "node tests/harness/keyboard/run.mjs",
    "h:counters": "node tests/harness/counters/run.mjs"
  },
  "dependencies": {
    "@swup/a11y-plugin": "5.2.1",
    "animejs": "4.5.0",
    "astro": "7.3.5",
    "lenis": "1.3.26",
    "swup": "4.10.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "sharp": "0.35.5",
    "size-limit": "14.1.0",
    "typescript": "6.0.3"
  }
}
