{
  "name": "portfolio-site",
  "private": true,
  "type": "module",
  "description": "derprito64bit's portfolio at derprito64bit.github.io: a static Astro site with one WebGL canvas (the Viewfinder direction).",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "tokens": "node scripts/build/tokens.mjs",
    "images": "node scripts/build/images.mjs",
    "build": "node scripts/build/tokens.mjs && node scripts/build/images.mjs && astro build",
    "astro:check": "astro check",
    "lint": "node scripts/check/lint.mjs",
    "check": "node scripts/check/run.mjs",
    "check:ownership": "node scripts/check/ownership.mjs",
    "check:deps": "node scripts/check/deps.mjs",
    "check:ph": "node scripts/check/ph-gate.mjs",
    "check:css": "node scripts/check/css-lint.mjs",
    "check:tokens": "node scripts/check/tokens-determinism.mjs",
    "size": "size-limit",
    "serve": "node scripts/serve-dist.mjs",
    "crew": "node scripts/crew.mjs",
    "test:w-f-unit": "node --test \"tests/w-f/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:smoke": "playwright test",
    "h:console": "node tests/harness/console/run.mjs",
    "h:overflow": "node tests/harness/overflow/run.mjs",
    "h:contrast": "node tests/harness/contrast/run.mjs",
    "h:content": "node tests/harness/content/run.mjs",
    "h:flash": "node tests/harness/flash/run.mjs",
    "h:axe": "node tests/harness/axe/run.mjs",
    "h:keyboard": "node tests/harness/keyboard/run.mjs",
    "h:idle": "node tests/harness/idle/run.mjs",
    "h:idle:negative": "node tests/harness/idle/negative.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/chivo-mono": "5.3.0",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "ogl": "1.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "14.1.0",
    "sharp": "0.35.5",
    "size-limit": "14.1.0",
    "typescript": "6.0.3"
  }
}
