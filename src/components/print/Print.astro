---
// STUB by W-F (Wave 3a). Owner: W-S2, then W-C4 (ownership.json). Replace freely within the slot contract:
// a link whose name is '{frame}, {title}', a [data-gl=print] slot with a data-poster still, alt='' on images.
import Slot from '../slot/Slot.astro';
import Text from '../../layouts/Text.astro';
import type { ProjectView } from '../../lib/content/index.ts';

interface Props {
  project: ProjectView;
  /** GL entity id; the sheet uses the slug so the project page dock can take the same print. */
  id: string;
}
const { project, id } = Astro.props;
---
<Slot as="a" kind="print" id={id} href={project.href} class="print">
  <svg data-poster class="print-still" viewBox="0 0 54 86" aria-hidden="true" focusable="false">
    <rect width="54" height="86" rx="1.5" fill="var(--paper)"></rect>
    <rect x="4" y="5" width="46" height="62" fill={project.tint}></rect>
  </svg>
  <span class="print-name"><span class="print-frame">{project.frame}</span>, <Text value={project.title} /></span>
</Slot>

<style>
  .print { display: grid; gap: var(--space-2); inline-size: 100%; min-inline-size: 140px; text-decoration: none; }
  .print-still { inline-size: 100%; block-size: auto; aspect-ratio: 54 / 86; border-radius: var(--radius-print); }
  .print-name { font: 500 var(--type-ui) / 1.3 var(--font-text); }
  .print-frame { font-family: var(--font-edge); text-transform: uppercase; letter-spacing: 0.04em; }
</style>
