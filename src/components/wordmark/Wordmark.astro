---
// The [derprito64bit] logotype, fitted to the content width at every width (W-D009): max(3rem, min(100cqi / 6.14,
// 24svh)). The name is wght 540, wdth 100; the brackets wght 800 in amber (W-D007: a logotype, aria-hidden, so the
// name reads as one word). One line at default spacing; under user text spacing or zoom it wraps instead of clipping
// (overflow-wrap anywhere). 0 JS for the fit.
// The brackets are the viewfinder: they rest 0.07em outside the name and close on it (detent spring) when the camera
// fires, at T0 and on every shutter press, never under reduced motion (hero.ts animates them, seekable on ?t=).
interface Props {
  id: string;
}
const { id } = Astro.props;
---
<div class="wordmark-fit">
  <h1 id={id} class="wordmark"><span class="br br-l" aria-hidden="true">[</span>derprito64bit<span class="br br-r" aria-hidden="true">]</span></h1>
</div>

<style is:global>
  /* The wordmark's own face: the same file as BG Mark (one download, preloaded by the layout), with its line box
     drawn to the glyphs. Measured in Chromium (canvas, 1000 px): ascenders and brackets reach 0.703em, the p's
     descender 0.141em (wght 540); the file's own box is 0.930 + 0.270em. With ascent 72% and descent 15% the text's
     box is the glyphs plus a hair, so the h1's box is exactly its text: nothing GL ever sits on it (W-D013) and the
     hero row can start right under it.
     The fallback draws the same box, so a late font moves nothing and the h1's text (its LCP area) is as large in
     either face: size-adjust 93.57% makes Arial Bold's "derprito64bit" (letter-spacing included) as wide as the
     face's at wght 540 (measured in Chromium at 390, 800, 1350 and 1440 px: 0.93567 to 0.93570), and since the
     overrides are scaled by size-adjust, they are 72% / 0.9357 and 15% / 0.9357 here. The brackets get their own
     fallback (Arial's are wider: at 93.57% the line would no longer fit and would wrap): 88.59% makes each 0.283em,
     the face's wght 800 bracket, so the fallback line is exactly as long as the real one. */
  @font-face { font-family: "BG Mark Tight"; src: url(/fonts/bricolage-mark.woff2) format("woff2"); font-weight: 300 800; font-stretch: 75% 100%; font-display: swap; ascent-override: 72%; descent-override: 15%; line-gap-override: 0%; }
  @font-face { font-family: "BG Mark Tight Fallback"; src: local("Arial Bold"), local("Arial-BoldMT"), local("Helvetica Neue Bold"); size-adjust: 93.57%; ascent-override: 76.95%; descent-override: 16.03%; line-gap-override: 0%; }
  @font-face { font-family: "BG Mark Bracket Fallback"; src: local("Arial Bold"), local("Arial-BoldMT"), local("Helvetica Neue Bold"); size-adjust: 88.59%; ascent-override: 81.27%; descent-override: 16.93%; line-gap-override: 0%; }
</style>

<style>
  .wordmark-fit { container-type: inline-size; }
  .wordmark {
    font-family: "BG Mark Tight", "BG Mark Tight Fallback", system-ui, sans-serif;
    font-weight: 540;
    font-stretch: 100%;
    font-size: var(--type-wordmark);
    letter-spacing: -0.012em;
    /* = ascent + descent of the face above: the line box is the text's box, no half-leading. */
    line-height: 0.87;
    white-space: normal;
    overflow-wrap: anywhere;
    text-wrap: wrap;
  }
  /* Inline, offset by relative position (not inline-block): the name and its brackets stay one line box. */
  .br {
    position: relative;
    color: var(--accent);
    font-family: "BG Mark Tight", "BG Mark Bracket Fallback", system-ui, sans-serif;
    font-weight: 800;
  }
  .br-l { inset-inline-start: -0.07em; }
  .br-r { inset-inline-start: 0.07em; }
  @media (forced-colors: active) {
    .br { color: CanvasText; }
  }
</style>
