---
// The first screen (W-S1, beat 1): the fitted [derprito64bit] wordmark, one line, one CTA, the real camera with its
// strip, and print 1. Owner: W-S1, then W-C14.
// - FCP paints the h1, the line, 'See the work', the strip and the baked camera poster as static DOM (W-D012, W-D029).
// - The stage (camera, print 1, the effects slot, the strip) is laid out before first paint by an inline run of
//   layout.ts, so nothing shifts; hero.ts re-runs it on width, font and text-spacing changes.
// - The data-hero script decides the choreography before the print is parsed: 'eject' on a fine pointer with hover,
//   WebGL2, full tier, motion on and no Save-Data; otherwise print 1 is a developed still from first paint.
// - GL arrives later through whenGL(): src/gl/camera draws the X-T5 in its stage-local view and runs the timeline.
import Wordmark from '../../components/wordmark/Wordmark.astro';
import CameraStrip from '../../components/camera-strip/CameraStrip.astro';
import Text from '../../layouts/Text.astro';
import { content } from '../../lib/content/index.ts';
import stillsManifest from '../../lib/content/stills.json';
import posters from '../../../public/posters/camera/posters.json';
import rig from '../../../assets-src/3d/camera_xt/rig.json';
import { heroLayout } from './layout.ts';
import { CARD, svgDataUri, testStripSvg } from './still.ts';
import { bandMarks, type Framing, type Rig } from './framing.ts';

type Band = 'split' | 'stacked' | 'phone';
interface PosterFile { w: number; h: number; avif: string; webp: string }
const BASE = '/posters/camera/';
const bands = posters.bands as unknown as Record<Band, Framing & { posters: { lod0: PosterFile[]; lod1: PosterFile[] } }>;

// Poster sets (stage.js posterSet, by media): touch shows the LOD1 set (lite draws LOD1, D-021); a fine pointer gets
// LOD1 up to 600 device px and LOD0 from 800 up, the tokens' LOD-by-projected-width rule in srcset form.
const set = (files: PosterFile[], fmt: 'avif' | 'webp') => files.map((f) => `${BASE}${f[fmt]} ${f.w}w`).join(', ');
const fineSet = (b: Band, fmt: 'avif' | 'webp') =>
  set([...bands[b].posters.lod1.filter((f) => f.w <= 600), ...bands[b].posters.lod0.filter((f) => f.w >= 800)], fmt);
const coarseSet = (b: Band, fmt: 'avif' | 'webp') => set(bands[b].posters.lod1, fmt);
const SPLIT = '(min-width: 64rem), (orientation: landscape) and (max-height: 500px)';
const FINE = '(pointer: fine) and (hover: hover)';
const sources: { media: string; band: Band; fine: boolean }[] = [
  { media: `(min-width: 64rem) and ${FINE}, (orientation: landscape) and (max-height: 500px) and ${FINE}`, band: 'split', fine: true },
  { media: SPLIT, band: 'split', fine: false },
  { media: `(max-width: 479px) and ${FINE}`, band: 'phone', fine: true },
  { media: '(max-width: 479px)', band: 'phone', fine: false },
  { media: FINE, band: 'stacked', fine: true },
];
const sizes = '(min-width: 64rem) or ((orientation: landscape) and (max-height: 500px)) 36vw, 64vw';
const fallback = bands.stacked.posters.lod1.find((f) => f.w === 600) ?? bands.stacked.posters.lod1[0];

// Rig markers projected into each band's poster: the flash centre (lens) and the drag hit areas (Look dial, lens).
const nodes = (rig as unknown as { lods: { lod0: { nodes: Record<string, { translation: [number, number, number] }> } } }).lods.lod0.nodes;
const markers: Rig = {
  lens_mount: nodes.lens_mount.translation,
  dial_look: nodes.dial_look.translation,
  print_exit: nodes.print_exit.translation,
  shutter_button: nodes.shutter_button.translation,
};
const marks = Object.fromEntries((['split', 'stacked', 'phone'] as Band[]).map((b) => [b, bandMarks(bands[b], markers)]));
const markVars = (['split', 'stacked', 'phone'] as Band[])
  .flatMap((b) => [
    `--mk-${b}-lens-x:${marks[b].lens.x}`, `--mk-${b}-lens-y:${marks[b].lens.y}`,
    `--mk-${b}-look-x:${marks[b].look.x}`, `--mk-${b}-look-y:${marks[b].look.y}`,
  ])
  .join(';');

// Print 1: the first featured project (W-D005). Its still is the built image, else the placeholder test strip.
const print1 = content.featured[0];
const stills = (stillsManifest as { stills: { slug: string; kind: string; src: string; avif: string; webp: string; width: number; height: number }[] }).stills;
const realStill = stills.find((s) => s.slug === print1.slug && s.kind === 'large' && s.src === print1.cover);
const stripUri = svgDataUri(testStripSvg({ slug: print1.slug, tint: print1.tint, frame: print1.frame }));
// The next prints the shutter makes: the following featured projects, as data the client reads.
const queue = content.featured.slice(1).map((p) => ({
  slug: p.slug,
  frame: p.frame,
  look: p.look,
  name: p.linkName,
  still: svgDataUri(testStripSvg({ slug: p.slug, tint: p.tint, frame: p.frame })),
}));

// The pre-paint layout run: layout.ts serialised, called on this section.
const layoutScript = `(${heroLayout.toString()})(document.currentScript.closest('.hero'));`;
// data-hero (W-D012): no fetch, under 0.5 kB. A runtime that never arrives still reveals print 1 (6 s safety).
const heroHead = `(function(h,c){if(matchMedia('(pointer: fine) and (hover: hover)').matches&&window.WebGL2RenderingContext&&h.dataset.motion!=='reduced'&&h.dataset.tier==='full'&&!(c&&c.saveData)){h.dataset.hero='eject';setTimeout(function(){if(h.dataset.hero==='eject'&&!h.dataset.heroRun)h.dataset.hero='done'},6e3)}else h.dataset.hero='still'})(document.documentElement,navigator.connection)`;
---
<section
  class="hero wrap"
  data-ground
  aria-labelledby="hero-title"
  data-hero-section
  data-aspect-split={bands.split.aspect}
  data-aspect-stacked={bands.stacked.aspect}
  data-aspect-phone={bands.phone.aspect}
  style={markVars}
>
  <script is:inline set:html={heroHead}></script>
  <Wordmark id="hero-title" />
  <div class="hero-row">
    <div class="hero-copy">
      <p class="hero-line"><Text value={content.profile.line} /></p>
      <p class="hero-cta"><a href="#work">See the work</a></p>
    </div>
    <script is:inline set:html={layoutScript}></script>
    <div class="hero-camera" data-gl="object" data-gl-id="camera" data-hero-camera>
      <picture>
        {sources.map((s) => (
          <>
            <source media={s.media} type="image/avif" srcset={s.fine ? fineSet(s.band, 'avif') : coarseSet(s.band, 'avif')} sizes={sizes} />
            <source media={s.media} type="image/webp" srcset={s.fine ? fineSet(s.band, 'webp') : coarseSet(s.band, 'webp')} sizes={sizes} />
          </>
        ))}
        <source type="image/avif" srcset={coarseSet('stacked', 'avif')} sizes={sizes} />
        <img class="hero-poster" data-poster src={BASE + fallback.webp} srcset={coarseSet('stacked', 'webp')} sizes={sizes} width={fallback.w} height={fallback.h} alt="" fetchpriority="high" decoding="async" />
      </picture>
      <span class="hero-hit" data-drag="look" aria-hidden="true"></span>
      <span class="hero-hit" data-drag="lens" aria-hidden="true"></span>
    </div>
    <div class="hero-print" data-gl="object" data-gl-id="hero-print" aria-hidden="true" data-hero-print data-slug={print1.slug} data-look={print1.look}>
      {realStill ? (
        <picture>
          <source type="image/avif" srcset={realStill.avif} />
          <img class="hero-still" data-poster data-lcp="print-1" src={realStill.webp} width={realStill.width} height={realStill.height} alt="" decoding="sync" />
        </picture>
      ) : (
        <img class="hero-still" data-poster data-lcp="print-1" src={stripUri} width={CARD.w * 10} height={CARD.h * 10} alt="" decoding="sync" />
      )}
    </div>
    <div class="hero-fx" data-gl="object" data-gl-id="hero-fx" aria-hidden="true"></div>
    <CameraStrip look={print1.look} />
    <div class="hero-flash" aria-hidden="true"></div>
  </div>
  <script type="application/json" data-hero-queue set:html={JSON.stringify(queue)}></script>
</section>
{realStill && <link rel="preload" as="image" href={realStill.avif} type="image/avif" media="(pointer: coarse), (prefers-reduced-motion: reduce)" />}

<script>
  import './hero.ts';
</script>

<style>
  .hero {
    /* Breathing room above the wordmark on tall screens only: 0 at 640 px, 28 px from about 1100 px. */
    padding-block: clamp(0px, calc((100svh - 640px) * 0.06), 28px) var(--space-7);
  }
  .hero-row {
    position: relative; /* the stage's coordinate box; no z-index, so it is not a stacking context (W-D013) */
  }
  .hero-copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .hero-line {
    font: 400 var(--type-lede) / 1.35 var(--font-text);
    max-inline-size: var(--measure-lede);
    color: var(--ink-2);
  }
  .hero-cta a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    background: var(--accent);
    color: var(--on-accent);
    font: 600 var(--type-ui) / 1.3 var(--font-text);
    text-decoration: none;
    border-radius: var(--radius-ui);
    transition: transform var(--spring-press-ms) var(--spring-press);
  }
  .hero-cta a:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .hero-cta a:hover { box-shadow: inset 0 -2px 0 color-mix(in srgb, #13171a 35%, transparent); }
  }
  @media (min-width: 64rem), (orientation: landscape) and (max-height: 500px) {
    .hero-copy { max-inline-size: calc(100% * 5 / 12 - var(--space-3)); }
  }

  /* ------------------------------------------------------------ the stage, unlaid (no JS): plain flow */
  .hero-camera {
    position: relative;
    margin-block-start: var(--space-5);
    inline-size: min(100%, 520px);
    aspect-ratio: 1.35;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .hero-poster {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    transition: opacity var(--dur-poster-fade) linear;
  }
  .hero-print {
    position: relative;
    inline-size: min(50%, 260px);
    aspect-ratio: 54 / 86;
    rotate: -2.2deg;
  }
  .hero-still {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border-radius: 2px;
    box-shadow: 0 1px 2px color-mix(in srgb, #13171a 22%, transparent), 0 10px 24px -6px color-mix(in srgb, #13171a 30%, transparent);
    transition: opacity var(--dur-gl-handback) linear;
  }
  .hero-fx { display: none; }
  .hero :global(.camera-strip) { margin-block-start: var(--space-4); }
  .hero-flash {
    position: fixed;
    inset: 0;
    z-index: var(--z-flash);
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--flash-x, 50%) var(--flash-y, 50%), #fff 0, color-mix(in srgb, #fff 70%, transparent) 9%, color-mix(in srgb, #fff 22%, transparent) 30%, transparent 58%);
  }
  .hero-hit { display: none; }

  /* ------------------------------------------------------------ the stage, laid out before first paint */
  .hero[data-laid] .hero-row { block-size: var(--row-h); }
  .hero[data-laid] .hero-camera,
  .hero[data-laid] .hero-print,
  .hero[data-laid] .hero-fx { position: absolute; margin: 0; aspect-ratio: auto; }
  .hero[data-laid] .hero-camera { inset-inline-start: var(--cam-x); inset-block-start: var(--cam-y); inline-size: var(--cam-w); block-size: var(--cam-h); }
  .hero[data-laid] .hero-print { inset-inline-start: var(--pr-x); inset-block-start: var(--pr-y); inline-size: var(--pr-w); block-size: var(--pr-h); }
  .hero[data-laid] .hero-fx { inset-inline-start: var(--fx-x); inset-block-start: var(--fx-y); inline-size: var(--fx-w); block-size: var(--fx-h); }
  .hero[data-laid][data-fx] .hero-fx { display: block; pointer-events: none; }
  .hero[data-laid]:not([data-arrangement='flow']) :global(.camera-strip) {
    position: absolute;
    inset-inline-start: var(--strip-x);
    inset-block-start: var(--strip-y);
    margin: 0;
  }
  .hero[data-laid][data-arrangement='flow'] .hero-row { block-size: auto; min-block-size: var(--row-h); }
  .hero[data-laid][data-arrangement='flow'] :global(.camera-strip) { margin-block-start: calc(var(--row-h) + var(--space-3)); }

  /* Print 1 waits for the eject on the full tier (W-D012); everywhere else it is developed from first paint. */
  :global(html[data-hero='eject']) .hero-still { opacity: 0; transition: none; }

  /* Drag hit areas over the Look dial and the lens ring: fine pointer and full tier only, aria-hidden bonuses. */
  @media (pointer: fine) and (hover: hover) {
    :global(html[data-tier='full']:not([data-motion='reduced'])) .hero[data-laid] .hero-hit {
      display: block;
      position: absolute;
      inline-size: 22%;
      aspect-ratio: 1;
      translate: -50% -50%;
      border-radius: 50%;
      cursor: ew-resize;
      touch-action: pan-y;
    }
  }
  .hero[data-band='split'] .hero-hit[data-drag='look'] { inset-inline-start: calc(var(--mk-split-look-x) * 100%); inset-block-start: calc(var(--mk-split-look-y) * 100%); inline-size: 14%; }
  .hero[data-band='split'] .hero-hit[data-drag='lens'] { inset-inline-start: calc(var(--mk-split-lens-x) * 100%); inset-block-start: calc(var(--mk-split-lens-y) * 100%); }
  .hero[data-band='stacked'] .hero-hit[data-drag='look'] { inset-inline-start: calc(var(--mk-stacked-look-x) * 100%); inset-block-start: calc(var(--mk-stacked-look-y) * 100%); inline-size: 14%; }
  .hero[data-band='stacked'] .hero-hit[data-drag='lens'] { inset-inline-start: calc(var(--mk-stacked-lens-x) * 100%); inset-block-start: calc(var(--mk-stacked-lens-y) * 100%); }
  .hero[data-band='phone'] .hero-hit[data-drag='look'] { inset-inline-start: calc(var(--mk-phone-look-x) * 100%); inset-block-start: calc(var(--mk-phone-look-y) * 100%); inline-size: 14%; }
  .hero[data-band='phone'] .hero-hit[data-drag='lens'] { inset-inline-start: calc(var(--mk-phone-lens-x) * 100%); inset-block-start: calc(var(--mk-phone-lens-y) * 100%); }

  @media (forced-colors: active) {
    .hero-cta a { border: 1px solid ButtonText; }
  }
</style>
