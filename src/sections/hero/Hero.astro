---
// STUB by W-F (Wave 3a). Owner: W-S1, then W-C14. The fitted wordmark, the line, the CTA, the camera stage and
// its strip land here (W-D009, W-D012). Keep the h1 as the first heading on the page.
import Wordmark from '../../components/wordmark/Wordmark.astro';
import Text from '../../layouts/Text.astro';
import { content } from '../../lib/content/index.ts';
---
<section class="hero wrap" data-ground aria-labelledby="hero-title">
  <Wordmark id="hero-title" />
  <p class="hero-line"><Text value={content.profile.line} /></p>
  <p class="hero-cta"><a href="#work">See the work</a></p>
</section>

<style>
  .hero { display: grid; gap: var(--space-5); padding-block: var(--space-6) var(--space-8); }
  .hero-line { font: 400 var(--type-lede) / 1.35 var(--font-text); max-inline-size: var(--measure-lede); }
  .hero-cta a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: var(--space-4);
    background: var(--accent);
    color: var(--on-accent);
    font: 600 var(--type-ui) / 1.3 var(--font-text);
    text-decoration: none;
    border-radius: var(--radius-ui);
  }
</style>
