---
// Shared fixture styles for /bench/ pages (underscore: not a route).
---
<style is:global>
  .bench { display: grid; gap: var(--space-7); padding-block: var(--space-6) var(--space-10); }
  .bench-head { display: grid; gap: var(--space-3); }
  .bench-controls { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .bench-controls select, .bench-controls button { min-block-size: 44px; padding-inline: var(--space-3); }
  .bench-out { max-block-size: 40svh; overflow: auto; font: 500 var(--type-edge) / 1.45 var(--font-edge); white-space: pre-wrap; }
  .fx-cube { inline-size: min(300px, 100%); aspect-ratio: 1; }
  /* Fixed gaps: an emulated height change also changes svh, which a real toolbar never does, so viewport units here
     would move the slots and test the emulator instead of the stage. */
  .fx-list { display: grid; gap: 600px; padding-block-end: 520px; }
  .fx-quad { display: block; inline-size: min(280px, 100%); aspect-ratio: 54 / 86; color: inherit; }
  .fx-name { display: block; padding: var(--space-3); font: 500 var(--type-ui) / 1.3 var(--font-text); }
  .fx-quad .bar { display: none; }
  html[data-debug="drift"] .fx-quad .bar { display: block; position: absolute; inset: 0 0 auto; block-size: 3px; background: rgb(0 255 var(--b)); }
  html[data-debug="drift"] .fx-name { visibility: hidden; }
</style>
