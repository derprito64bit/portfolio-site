---
// Refraction concept (direction reset, #101): one material, liquid glass. Markup is the accessible layer; the WebGL
// canvas behind it mirrors the display type and plates and refracts them through the lens.
import Layout from '../concept/Layout.astro';
import { OWNER_NAME, HANDLE, GITHUB, projects, award, medal, nameLines } from '../concept/content';

const ticks = Array.from({ length: 19 }, (_, i) => i - 9);
const data = { projects, owner: OWNER_NAME, handle: HANDLE };
---
<Layout title={`${OWNER_NAME}: personal portfolio`}>
  <canvas class="gl" aria-hidden="true"></canvas>
  <a class="skip" href="#work">Skip to work</a>

  <div class="pre" id="pre" role="progressbar" aria-label="Loading" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <p class="pre__count" aria-hidden="true"><span class="m-mask"><span class="pre__num" data-gl-text>000</span></span></p>
    <p class="pre__label">Loading</p>
    <button class="pre__skip" type="button">Skip intro <kbd>Enter</kbd></button>
  </div>

  <header class="bar">
    <a class="bar__handle" href="#top">{HANDLE}</a>
    <nav class="bar__nav" aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#honours">Honours</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main id="top">
    <div class="theatre" id="theatre">
      <section class="intro layer" aria-labelledby="name">
        <div class="intro__inner">
          <div class="intro__row">
            <p class="intro__kicker"><span class="m-mask"><span class="intro__k">Personal portfolio</span></span></p>
            <span class="ph-tag intro__ph">[PLACEHOLDER: real name]</span>
          </div>
          <h1 class="intro__name" id="name">
            <span class="sr-only">{OWNER_NAME}</span>
            <span class="intro__vis" aria-hidden="true">
              {nameLines.map((l, i) => <span class={`m-mask nl-mask nl-mask--${i + 1}`}><span class="nl" data-gl-text>{[...l].map((ch) => <span class="nc">{ch === ' ' ? '\u00a0' : ch}</span>)}</span></span>)}
            </span>
          </h1>
        </div>
      </section>

      <div class="evf layer" aria-hidden="true">
        <svg class="evf__c evf__c--tl" viewBox="0 0 40 40"><path d="M1 39V1h38" /></svg>
        <svg class="evf__c evf__c--tr" viewBox="0 0 40 40"><path d="M1 1h38v38" /></svg>
        <svg class="evf__c evf__c--bl" viewBox="0 0 40 40"><path d="M1 1v38h38" /></svg>
        <svg class="evf__c evf__c--br" viewBox="0 0 40 40"><path d="M39 1v38H1" /></svg>
        <div class="evf__top">
          <span class="evf__chip">M</span>
          <span class="evf__ro" data-ro="af">AF-S</span>
          <svg class="evf__meter" viewBox="0 0 26 18"><path d="M6 1.5H1.5v15H6M20 1.5h4.5v15H20" /><circle cx="13" cy="9" r="3.2" /></svg>
          <span class="evf__ro">AWB</span>
          <span class="evf__gap"></span>
          <span class="evf__ro evf__frames" data-ro="frames">008</span>
          <svg class="evf__batt" viewBox="0 0 32 14"><path d="M1 1h26v12H1zM29.5 5v4" /><path class="evf__cells" d="M6 4v6M11 4v6M16 4v6" /></svg>
        </div>
        <svg class="evf__af" viewBox="0 0 120 84"><path d="M1 18V1h18M101 1h18v17M119 66v17h-18M19 83H1V66" /></svg>
        <div class="evf__level"><svg viewBox="0 0 420 14"><path d="M0 7h178M242 7h178" /><path class="evf__lvc" d="M196 7h28" /></svg></div>
        <div class="evf__hist"><svg viewBox="0 0 120 48" preserveAspectRatio="none"><path class="evf__hframe" d="M0.5 0.5h119v47H0.5z" /><path class="evf__hfill" d="M0 48h120z" /></svg></div>
        <div class="evf__bottom">
          <span class="evf__big" data-ro="shutter">1/125</span>
          <span class="evf__big">F<span data-ro="aperture">2.0</span></span>
          <div class="evf__scalewrap">
            <svg class="evf__scale" viewBox="0 -10 300 40">
              {ticks.map((t) => <path class={t % 3 === 0 ? 'evf__tk evf__tk--major' : 'evf__tk'} d={`M${150 + t * 15} ${t % 3 === 0 ? 2 : 6}v${t % 3 === 0 ? 12 : 6}`} />)}
              {[-3, -2, -1, 0, 1, 2, 3].map((n) => <text x={150 + n * 45} y="27" text-anchor="middle">{n > 0 ? `+${n}` : n}</text>)}
              <path class="evf__mark" d="M150 -1l-4.5 -7h9z" />
            </svg>
          </div>
          <span class="evf__ev" data-ro="ev">±0</span>
          <span class="evf__big"><span class="evf__u">ISO</span> <span data-ro="iso">400</span></span>
        </div>
      </div>

      <section class="work layer" id="work" aria-labelledby="work-h">
        <h2 class="work__h" id="work-h">Work</h2>
        <div class="stage" aria-hidden="true">
          <div class="stage__plate plate" data-flip-id="plate"></div>
        </div>
        <ol class="chapters">
          {projects.map((p, i) => (
            <li class="chapter" id={p.slug} data-i={i}>
              <article class="chapter__art" aria-labelledby={`${p.slug}-t`}>
                <div class="chapter__plate plate" data-slug={p.slug} style={`--tint:${p.tint}`}></div>
                <div class="chapter__text">
                  <p class="chapter__num" aria-hidden="true"><span class="m-mask"><span class="chapter__digits" data-gl-text>{[...p.num].map((ch) => <span class="cd">{ch}</span>)}</span></span></p>
                  <h3 class="chapter__title" id={`${p.slug}-t`}>
                    <span class="chapter__label">Project {p.num}</span>
                    <span class="chapter__name ph">{p.title}</span>
                  </h3>
                  <dl class="chapter__meta">
                    <div><dt>Role</dt><dd class="ph">{p.role}</dd></div>
                    <div><dt>Year</dt><dd class="ph">{p.year}</dd></div>
                  </dl>
                  <button class="open" type="button" data-open={p.slug}>Open project <span class="open__arrow" aria-hidden="true">&#8594;</span></button>
                </div>
              </article>
            </li>
          ))}
        </ol>
        <div class="rail">
          <nav aria-label="Projects">
            <ol class="rail__list">
              {projects.map((p, i) => <li><button class="rail__b" type="button" data-go={i} aria-label={`Project ${p.num}`}>{p.num}</button></li>)}
            </ol>
          </nav>
          <p class="rail__note">Covers are placeholders, generated in code</p>
        </div>
      </section>
    </div>

    <section class="honours" id="honours" aria-labelledby="honours-h">
      <div class="honours__head">
        <h2 class="honours__h" id="honours-h">Honours</h2>
        <p class="honours__note">DECA glass awards and medals <span class="ph-tag">[TO CONFIRM: details]</span></p>
      </div>
      <ol class="honours__list">
        <li class="honour honour--award">
          <p class="honour__word" aria-hidden="true"><span class="m-mask"><span class="honour__w" data-gl-text>Award</span></span></p>
          <div class="honour__form" data-form="plaque"></div>
          <div class="honour__detail">
            <h3 class="honour__title ph">{award.title}</h3>
            <dl class="honour__meta">
              <div><dt>Event</dt><dd class="ph">{award.event}</dd></div>
              <div><dt>Placing</dt><dd class="ph">{award.placement}</dd></div>
              <div><dt>Year</dt><dd class="ph">{award.year}</dd></div>
            </dl>
          </div>
        </li>
        <li class="honour honour--medal">
          <p class="honour__word" aria-hidden="true"><span class="m-mask"><span class="honour__w" data-gl-text>Medal</span></span></p>
          <div class="honour__form" data-form="disc"></div>
          <div class="honour__detail">
            <h3 class="honour__title ph">{medal.title}</h3>
            <dl class="honour__meta">
              <div><dt>Event</dt><dd class="ph">{medal.event}</dd></div>
              <div><dt>Placing</dt><dd class="ph">{medal.placement}</dd></div>
              <div><dt>Year</dt><dd class="ph">{medal.year}</dd></div>
            </dl>
          </div>
        </li>
      </ol>
    </section>

    <footer class="contact" id="contact" aria-labelledby="contact-h">
      <h2 class="contact__h" id="contact-h">Contact</h2>
      <p class="contact__line">
        <a class="contact__link" href={GITHUB} rel="noopener"><span class="contact__lt" data-gl-text><span class="contact__w">github.com/</span><wbr /><span class="contact__w">{HANDLE}</span></span></a>
        <span class="ph-tag">[TO CONFIRM]</span>
      </p>
      <p class="contact__other">Email and other links <span class="ph">[PLACEHOLDER: links]</span></p>
      <div class="contact__foot">
        <span>{HANDLE}</span>
        <a href="#top" class="contact__top">Back to top</a>
      </div>
    </footer>
  </main>

  <div class="pv" id="pv" role="dialog" aria-modal="true" aria-labelledby="pv-title" hidden>
    <div class="pv__scroll" id="pv-scroll">
      <div class="pv__hero plate" data-flip-id="plate"></div>
      <div class="pv__head">
        <p class="pv__num" aria-hidden="true"><span class="m-mask"><span class="pv__digits" data-gl-text>01</span></span></p>
        <div class="pv__titles">
          <p class="pv__label">Project 01</p>
          <h2 class="pv__title ph" id="pv-title">[PLACEHOLDER: project title]</h2>
        </div>
      </div>
      <dl class="pv__meta"></dl>
      <div class="pv__body"></div>
      <div class="pv__media"></div>
      <div class="pv__next">
        <button class="pv__nextb" type="button"><span class="pv__nextl">Next</span> <span class="pv__nextn">Project 02</span></button>
      </div>
    </div>
    <button class="pv__back" type="button">Back <kbd>Esc</kbd></button>
  </div>

  <script type="application/json" id="r-data" set:html={JSON.stringify(data)} />
  <script>
    import '../concept/main.ts';
  </script>
</Layout>
