        "tracking": "-0.02em",
        "lh": 1,
        "wrap": "allowed; 2-line min-height below 64rem"
      },
      "title": {
        "css": "clamp(1.625rem, 1.402rem + 0.915vw, 2.5rem)",
        "wght": 650,
        "tracking": "-0.02em",
        "lh": 1.05
