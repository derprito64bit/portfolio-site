{
  "$format": "DTCG Format Module 2025.10; project data under $extensions['dev.derprito64bit']; source content/tokens.json; scripts/build/tokens.mjs (zero deps) emits src/styles/tokens.css, src/lib/tokens.js, manor-overlay.css (--ion-* under :where(:root)), identity.json (JsonUtility-flat) and can-enter-manor.js (inline guard snippet for publish.ps1)",
  "colour": {
    "light": {
      "table": "#E3E6E6",
      "table-lit": "#EEF0EF",
      "paper": "#F6F5F1",
      "proof": "#E7EAE9",
      "rule": "#BFC6C8",
      "ink": "#13171A",
      "ink-2": "#444D52"
    },
    "dark": {
      "table": "#14181A",
      "table-lit": "#1C2225",
      "paper": "#E7E6E1",
      "rule": "#2C3438",
      "ink": "#E9ECEA",
      "ink-2": "#A9B2B5",
      "note": "proof and paper stay light in the dark scheme (they are paper); focus colour follows the surface"
    },
    "door": {
      "darkroom": "#14100E",
      "on-dark": "#ECE8E0",
      "on-dark-2": "#B9B3A9",
      "on-dark-3": "#9C968C",
      "darkSchemeBoundary": "1 px amber rule plus a 6% safelight wash at the door's top edge; dark table vs darkroom measures 1.06:1, so the boundary must be drawn"
    },
    "accent": {
      "amber": "#E39B2B",
      "amber-deep": "#875802",
      "on-accent": "#13171A",
      "brass": {
        "value": "#C59A45",
        "use": "Manor material albedo only (pending owner, crossTrack)"
      }
    },
    "manor": {
      "paper": "#EFEBE3",
      "graphite": "#383D47",
      "wood-1": "#7A4E33",
      "wood-2": "#C8A273",
      "night": "#120C10",
      "scrim": "rgb(18 12 16 / 0.72)"
    },
    "ink-drip": "#14100E (= door.darkroom; also the /manor/ loader's first frame)",
    "roles": {
      "light": {
        "--accent": "amber",
        "--accent-text": "amber-deep",
        "--on-accent": "ink",
        "--placeholder": "ink-2"
      },
      "dark": {
        "--accent": "amber",
        "--accent-text": "amber",
        "--on-accent": "#13171A",
        "--placeholder": "ink-2"
      },
      "door": {
        "--accent-text": "amber"
      }
    },
    "focusBySurface": {
      "lightSurfaces": {
        "surfaces": [
          "table (light)",
          "table-lit",
          "paper",
          "proof",
          "prints (both schemes)"
        ],
        "--focus": "#13171A",
        "--focus-halo": "#F6F5F1"
      },
      "darkSurfaces": {
        "surfaces": [
          "door",
          "negative sleeve",
          "table (dark)",
          "table-lit (dark)"
        ],
        "--focus": "#E39B2B",
        "--focus-halo": "#14100E"
      }
    },
    "contrastMeasured": {
      "ink on amber": 7.72,
      "amber-deep on table": 4.88,
      "amber on darkroom": 8.1,
      "ink-2 on table": 6.89,
      "on-dark-3 on darkroom": 6.44,
      "amber on table": "1.86 (never text)",
      "dark table vs darkroom": "1.06 (surfaces; boundary drawn)"
    },
    "scheme": "prefers-color-scheme guarded by :root:not([data-theme=light]), plus :root[data-theme=dark]"
  },
  "type": {
    "families": {
      "bricolage": {
        "licence": "OFL-1.1",
        "files": {
          "mark": {
