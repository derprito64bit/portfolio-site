      "display": {
        "css": "clamp(2.125rem, 1.392rem + 3.007vw, 5rem)",
        "wght": 650,
        "tracking": "-0.025em (-0.02em below 48rem)",
        "lh": 1
      },
      "index": {
        "css": "clamp(2.25rem, 1.294rem + 3.922vw, 6rem)",
