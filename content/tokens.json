        "tracking": "-0.005em",
        "lh": 1.35,
        "measure": "34ch"
      },
      "body": {
        "css": "clamp(1rem, 0.968rem + 0.131vw, 1.125rem)",
        "wght": 400,
        "lh": 1.55,
        "measure": "62ch"
      },
      "ui": {
        "px": 15,
        "wght": "500 (CTA 600)",
        "lh": 1.3
      },
      "edge": {
        "px": 12,
        "family": "Geist Mono",
        "wght": 500,
        "tracking": "+0.02em (+0.04em uppercase codes)",
        "lh": 1.45
      },
      "placeholderSlot": {
        "family": "Geist Mono",
        "wght": 500,
        "size": "max(12px, 0.8em), max 20px",
        "rule": "1px dashed var(--placeholder)",
        "radius": "2px",
        "wrap": "inside the slot, box-decoration-break clone"
      }
